[core]
    editor = code --wait
    autocrlf = input
    pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    line-numbers = true

[credential]
    # Empty value resets the helper list, dropping Homebrew's system-level
    # ad-hoc-signed osxkeychain helper whose keychain ACL trust breaks on every
    # `brew upgrade git` (re-prompts for the login keychain). Pin the Apple-signed
    # CLT helper instead — stable code-signing identity, so "Always Allow" sticks.
    helper =
    helper = /Library/Developer/CommandLineTools/usr/libexec/git-core/git-credential-osxkeychain

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit

# Default: personal account
[include]
    path = ~/.gitconfig-personal

# Branch on the remote URL — regardless of where the repo lives, an internal
# host overrides with the work account. (Requires git 2.36+.) A new repo counts
# as personal until a remote is attached; the branch applies as soon as one is
# added.
# Patterns are fnmatch-based: ** matches across path separators, covering the
# various URL forms.
[includeIf "hasconfig:remote.*.url:https://**oss.navercorp.com/**"]
    path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:git@**oss.navercorp.com:**"]
    path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:ssh://**oss.navercorp.com/**"]
    path = ~/.gitconfig-work

# Machine-local overrides (gitignored). Use this file for signingkey and any
# other per-machine values. Loaded LAST so it always wins.
# Example contents:
#   [user]
#       signingkey = ~/.ssh/id_ed25519.pub
[include]
    path = ~/.gitconfig.local
