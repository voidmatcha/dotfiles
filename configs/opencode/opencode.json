{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "deny",
      "sudo *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git reset *": "ask",
      "git clean*": "deny",
      "npm publish*": "ask",
      "pnpm publish*": "ask"
    },
    "doom_loop": "ask"
  },
  "plugin": [
    "oh-my-openagent@latest",
    "@ex-machina/opencode-anthropic-auth@1.8.0"
  ]
}
