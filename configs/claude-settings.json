{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "REVIEW_LOOP_CODEX_FLAGS": "--sandbox workspace-write",
    "ENABLE_CODE_SECURITY_REVIEW": "0"
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "WebFetch",
      "mcp__filesystem"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "serena",
    "codegraph",
    "context7"
  ],
  "disabledMcpjsonServers": [],
  "skillOverrides": {
    "superpowers:using-git-worktrees": "off",
    "superpowers:dispatching-parallel-agents": "off",
    "e2e-reviewer": "user-invocable-only",
    "e2e-test-reviewer": "user-invocable-only",
    "e2e-test-debugger": "user-invocable-only",
    "playwright-debugger": "user-invocable-only",
    "playwright-test-generator": "user-invocable-only",
    "cypress-debugger": "user-invocable-only",
    "ui-reverse-engineering": "user-invocable-only",
    "ui-capture": "user-invocable-only",
    "visual-debug": "user-invocable-only",
    "deploy-to-vercel": "user-invocable-only",
    "vercel-optimize": "user-invocable-only",
    "vercel-cli-with-tokens": "user-invocable-only",
    "vercel-react-best-practices": "user-invocable-only",
    "vercel-react-native-skills": "user-invocable-only",
    "vercel-react-view-transitions": "user-invocable-only",
    "vercel-composition-patterns": "user-invocable-only",
    "ai-slop-cleaner": "user-invocable-only",
    "project-session-manager": "user-invocable-only"
  },
  "allowedMcpServers": [
    {
      "serverName": "chrome-devtools"
    },
    {
      "serverName": "serena"
    },
    {
      "serverName": "codegraph"
    },
    {
      "serverName": "context7"
    },
    {
      "serverName": "exa"
    },
    {
      "serverName": "linkedin"
    }
  ],
  "deniedMcpServers": [
    {
      "serverName": "filesystem"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pretool-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pretool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-md-edit-warn.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/work-scope-guard.sh"
          }
        ]
      }
    ]
  },
  "allowManagedMcpServersOnly": true,
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": false,
    "autoresearch@autoresearch": false,
    "claude-hud@claude-hud": true,
    "skills-janitor@skills-janitor": true,
    "codex@openai-codex": true,
    "session-wrap": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "fakechat@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "review-loop@hamel-review": false,
    "comprehensive-review@claude-code-workflows": true,
    "documentation-generation@claude-code-workflows": true,
    "javascript-typescript@claude-code-workflows": false,
    "python-development@claude-code-workflows": false,
    "frontend-mobile-development@claude-code-workflows": false,
    "security-scanning@claude-code-workflows": false,
    "unit-testing@claude-code-workflows": false,
    "git-pr-workflows@claude-code-workflows": false,
    "tdd-workflows@claude-code-workflows": false,
    "error-debugging@claude-code-workflows": false,
    "ui-design@claude-code-workflows": false,
    "accessibility-compliance@claude-code-workflows": false,
    "content-marketing@claude-code-workflows": false,
    "seo-content-creation@claude-code-workflows": false,
    "seo-technical-optimization@claude-code-workflows": false,
    "seo-analysis-monitoring@claude-code-workflows": false,
    "claude-mem@thedotmack": true,
    "local-skills@dotfiles-local": true
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "skills-janitor": {
      "source": {
        "source": "github",
        "repo": "khendzel/skills-janitor"
      }
    },
    "autoresearch": {
      "source": {
        "source": "github",
        "repo": "uditgoenka/autoresearch"
      }
    },
    "hamel-review": {
      "source": {
        "source": "github",
        "repo": "hamelsmu/claude-review-loop"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "autoInstallIdeExtension": false
}
