.DS_Store
# Python runtime caches generated by local verification/review helpers.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
configs/.gitconfig-*.backup*
.sisyphus/
# Handover run artifacts (handover.py DEFAULT_OUT_ROOT) — per-run, never commit.
.handover/
# Serena MCP runtime state (project.local.yml, memories/, cache/) — machine-local.
.serena/
*.secrets.env
# Per-machine git overrides (signingkey paths etc.) — never commit.
.gitconfig.local
.gitconfig.local-work
# Per-machine shell env (local exports, secrets) — never commit.
.zshrc.local
.claude/settings.local.json
# Claude review-loop plugin state/artifacts are per-session and generated.
.claude/review-loop.local.md
.claude/review-loop.log
.claude/review-loop-run-codex.sh
.claude/review-loop-codex-prompt.txt
# Claude hook runtime telemetry is per-session and machine-local.
.claude/hooks/.logs/
reviews/
# Per-machine agent/skill Markdown overrides; see plugins/local-skills/CONVENTIONS.md.
*.local.md
*.local.mdc
